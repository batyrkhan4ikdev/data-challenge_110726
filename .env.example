# Organizer dataset endpoint: the full "Открыть GET для DEV" URL from the guide PDF (contains a signed sig=).
# The server replaces the group_id query parameter per request.
DATASET_URL=

# Model profile from config/profiles.toml, plus evaluation defaults
LLM_PROFILE=fake
EVAL_MODE=single
EVAL_K=1
EVAL_CONCURRENCY=4

# Self-hosted vLLM on H200 (Cloudflare tunnel, --api-key)
H200_BASE_URL=
H200_API_KEY=

# Paid API fallback (OpenAI-compatible)
PAID_BASE_URL=
PAID_API_KEY=
