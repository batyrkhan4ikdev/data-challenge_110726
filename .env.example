# Organizer dataset endpoint: the full "Открыть GET для DEV" URL from the guide PDF (contains a signed sig=).
# The server replaces the group_id query parameter per request.
DATASET_URL=

# Comma-separated Dynamics org origins (e.g. https://example.crm.dynamics.com). Empty disables CORS.
CQA_ALLOWED_ORIGINS=

# Model profile from config/profiles.toml, plus evaluation defaults
LLM_PROFILE=fake
EVAL_MODE=single
EVAL_K=1
EVAL_CONCURRENCY=8
# run_batch re-runs dialogs that failed on LLM_PROFILE on these profiles, in order (e.g. H200 tunnel down, cloud rate limit)
FALLBACK_PROFILE=aigw-sonnet,aigw-luna,h200-glimmer

# Self-hosted vLLM on H200 (Cloudflare named tunnel, one shared --api-key)
H200_API_KEY=
H200_GEMMA_BASE_URL=https://hk-gemma.sek.su/v1
H200_KZ_BASE_URL=https://hk-kz.sek.su/v1
H200_GLIMMER_BASE_URL=https://hk-glimmer.sek.su/v1

# Paid / cloud models via an OpenAI-compatible gateway (profiles aigw-*)
AIGW_BASE_URL=
AIGW_API_KEY=
# team_name in results/<dev|prod>/results.json (run_batch --submit)
TEAM_NAME=fantastik 4
# Optional: OpenRouter for frontier-model comparisons (profiles or-*)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
