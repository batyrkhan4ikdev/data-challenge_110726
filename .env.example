# Organizer dataset endpoint: the full "Открыть GET для DEV" URL from the guide PDF (contains a signed sig=).
# The server replaces the group_id query parameter per request.
DATASET_URL=

# Model profile from config/profiles.toml, plus evaluation defaults
LLM_PROFILE=fake
EVAL_MODE=single
EVAL_K=1
EVAL_CONCURRENCY=4

# Self-hosted vLLM on H200 (Cloudflare named tunnel, one shared --api-key)
H200_API_KEY=
H200_GEMMA_BASE_URL=https://hk-gemma.sek.su/v1
H200_GPTOSS_BASE_URL=https://hk-gptoss.sek.su/v1
H200_KZ_BASE_URL=https://hk-kz.sek.su/v1

# Paid API fallback (OpenAI-compatible)
PAID_BASE_URL=
PAID_API_KEY=
